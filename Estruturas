from datetime import datetime

class No:
    def __init__(self, dado):
        self.dado = dado
        self.proximo = None

class ListaEncadeada:
    def __init__(self):
        self.inicio = None
        self.fim = None
        self.tamanho = 0

    def esta_vazia(self):
        if self.tamanho == 0:
            return True
        return False

    def inserir_fim(self, dado):
        novo = No(dado)
        if self.esta_vazia():
            self.inicio = novo
            self.fim = novo
        else:
            self.fim.proximo = novo
            self.fim = novo
        self.tamanho += 1

    def remover(self, condicao):
        anterior = None
        atual = self.inicio
        while atual != None:
            if condicao(atual.dado):
                if anterior == None:
                    self.inicio = atual.proximo
                else:
                    anterior.proximo = atual.proximo
                if atual == self.fim:
                    self.fim = anterior
                self.tamanho -= 1
                return atual.dado
            anterior = atual
            atual = atual.proximo
        return None

    def buscar(self, condicao):
        atual = self.inicio
        while atual != None:
            if condicao(atual.dado):
                return atual.dado
            atual = atual.proximo
        return None

    def __iter__(self):
        atual = self.inicio
        while atual != None:
            yield atual.dado
            atual = atual.proximo

    def __len__(self):
        return self.tamanho

class FilaValidade:
    def __init__(self):
        self.itens = ListaEncadeada()

    def enfileirar(self, lote):
        self.itens.inserir_fim(lote)

    def proximo_lote(self):
        mais_velho = None
        for lote in self.itens:
            if lote.quantidade > 0:
                if mais_velho == None:
                    mais_velho = lote
                elif lote.data_vencimento < mais_velho.data_vencimento:
                    mais_velho = lote
        return mais_velho

    def quantidade_total(self):
        total = 0
        for lote in self.itens:
            total = total + lote.quantidade
        return total

    def __iter__(self):
        return iter(self.itens)


class Produto:
    def __init__(self, nome, preco_compra, preco_venda, data_compra, data_vencimento, quantidade, tipo="ingrediente"):
        self.nome = nome
        self.preco_compra = preco_compra
        self.preco_venda = preco_venda
        self.data_compra = data_compra
        self.data_vencimento = data_vencimento
        self.quantidade = quantidade
        self.tipo = tipo

    def __repr__(self):
        return "Produto(" + self.nome + ", qtd=" + str(self.quantidade) + ")"


class ItemComanda:
    def __init__(self, nome, tipo, preco_unitario, quantidade=1):
        self.nome = nome
        self.tipo = tipo
        self.preco_unitario = preco_unitario
        self.quantidade = quantidade

    def valor_total(self):
        return self.preco_unitario * self.quantidade

    def __repr__(self):
        return f"{self.quantidade}x {self.nome} ({self.tipo})"


class Comanda:
    def __init__(self, numero, cliente):
        self.numero = numero
        self.cliente = cliente
        self.data_hora_abertura = datetime.now()
        self.data_hora_fechamento = None
        self.itens = ListaEncadeada()
        self.aberta = True

    def adicionar_item(self, item):
        if self.aberta == False:
            raise Exception("comanda ja foi fechada, nao da pra adicionar item")
        self.itens.inserir_fim(item)

    def remover_item(self, nome_item):
        if self.aberta == False:
            raise Exception("comanda ja foi fechada, nao da pra remover item")
        return self.itens.remover(lambda i: i.nome == nome_item)

    def valor_total(self):
        total = 0
        for item in self.itens:
            total += item.valor_total()
        return total

    def fechar(self):
        self.aberta = False
        self.data_hora_fechamento = datetime.now()

    def __repr__(self):
        if self.aberta:
            status = "aberta"
        else:
            status = "fechada"
        return f"Comanda #{self.numero} - {self.cliente} ({status})"


class Pagamento:
    def __init__(self, nome_pagador, numero_comanda, forma_pagamento, valor_total):
