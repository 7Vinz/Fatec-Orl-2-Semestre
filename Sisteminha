from estruturas import ListaEncadeada, FilaValidade, Produto, ItemComanda, Comanda, Pagamento, RegistroConsumo

class Estoque:
    def __init__(self):
        self.produtos = ListaEncadeada()

    def buscar_fila(self, nome):
        par = self.produtos.buscar(lambda p: p[0] == nome)
        if par == None:
            return None
        return par[1]

    def adicionar_produto(self, produto):
        fila = self.buscar_fila(produto.nome)
        if fila == None:
            fila = FilaValidade()
            self.produtos.inserir_fim((produto.nome, fila))
        fila.enfileirar(produto)

    def editar_quantidade(self, nome_produto, nova_quantidade):
        fila = self.buscar_fila(nome_produto)
        if fila == None:
            raise Exception("produto " + nome_produto + " nao existe no estoque")
        lote = fila.proximo_lote()
        if lote == None:
            raise Exception("nao tem lote disponivel de " + nome_produto)
        lote.quantidade = nova_quantidade

    def preco_venda(self, nome_produto):
        fila = self.buscar_fila(nome_produto)
        if fila == None:
            return None
        lote = fila.proximo_lote()
        if lote == None:
            return None
        return lote.preco_venda

    def baixar_estoque(self, nome_produto, quantidade):
        fila = self.buscar_fila(nome_produto)
        if fila == None:
            raise Exception("produto " + nome_produto + " nao existe no estoque")

        restante = quantidade
        while restante > 0:
            lote = fila.proximo_lote()
            if lote == None:
                raise Exception("estoque insuficiente de " + nome_produto)
            if lote.quantidade <= restante:
                restante = restante - lote.quantidade
                lote.quantidade = 0
            else:
                lote.quantidade = lote.quantidade - restante
                restante = 0

    def quantidade_disponivel(self, nome_produto):
        fila = self.buscar_fila(nome_produto)
        if fila == None:
            return 0
        return fila.quantidade_total()

class SistemaRestaurante:
    def __init__(self):
        self.estoque = Estoque()
        self.comandas_abertas = ListaEncadeada()
        self.comandas_fechadas = ListaEncadeada()
        self.pagamentos = ListaEncadeada()
        self.consumos = ListaEncadeada()
        self.proximo_numero_comanda = 1

    def abrir_comanda(self, cliente):
        comanda = Comanda(self.proximo_numero_comanda, cliente)
        self.proximo_numero_comanda += 1
        self.comandas_abertas.inserir_fim(comanda)
        return comanda

    def buscar_comanda_aberta(self, numero):
        return self.comandas_abertas.buscar(lambda c: c.numero == numero)

    def adicionar_pedido(self, numero_comanda, nome_item, tipo):
        comanda = self.buscar_comanda_aberta(numero_comanda)
        if comanda == None:
            raise Exception("comanda " + str(numero_comanda) + " nao esta aberta")
        preco = self.estoque.preco_venda(nome_item)
        if preco == None:
            raise Exception("item " + nome_item + " nao existe no cardapio/estoque")
        item = ItemComanda(nome_item, tipo, preco)
        comanda.adicionar_item(item)

    def remover_pedido(self, numero_comanda, nome_item):
        comanda = self.buscar_comanda_aberta(numero_comanda)
        if comanda == None:
            raise Exception("comanda " + str(numero_comanda) + " nao esta aberta")
        comanda.remover_item(nome_item)

    def fechar_comanda(self, numero_comanda, forma_pagamento):
        comanda = self.comandas_abertas.remover(lambda c: c.numero == numero_comanda)
        if comanda == None:
            raise Exception("comanda " + str(numero_comanda) + " nao esta aberta")

        itens_consumidos = []
        for item in comanda.itens:
            self.estoque.baixar_estoque(item.nome, item.quantidade)
            itens_consumidos.append(item)

        comanda.fechar()
        valor_total = comanda.valor_total()
        self.comandas_fechadas.inserir_fim(comanda)

        pagamento = Pagamento(comanda.cliente, comanda.numero, forma_pagamento, valor_total)
        self.pagamentos.inserir_fim(pagamento)

        registro = RegistroConsumo(comanda.numero, comanda.cliente, itens_consumidos, valor_total)
        self.consumos.inserir_fim(registro)

        return pagamento
